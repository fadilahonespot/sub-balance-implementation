# Database Sharding Configuration
SHARD_1_DSN=postgres://postgres:postgres@localhost:5432/sub_balance_shard_1?sslmode=disable
SHARD_2_DSN=postgres://postgres:postgres@localhost:5433/sub_balance_shard_2?sslmode=disable
SHARD_3_DSN=postgres://postgres:postgres@localhost:5434/sub_balance_shard_3?sslmode=disable

# Redis Configuration (for advisory locks)
REDIS_URL=redis://localhost:6379

# Application Configuration
APP_PORT=8080
LOG_LEVEL=info

# Sharding Configuration
SHARD_COUNT=3
SHARD_STRATEGY=consistent_hashing

# Database Connection Pool
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300s

# Advisory Lock Configuration
ADVISORY_LOCK_TIMEOUT=5s
ADVISORY_LOCK_RETRY_COUNT=3
ADVISORY_LOCK_RETRY_DELAY=100ms
